# Copy to config/.env, fill on your server, and chmod 600.
# config/.env, data/, and web-admin credentials must never be committed.
# Required: HTTPS origin without /bitget or another path.
BITGET_WEB_ORIGIN=https://monitor.example.com
# Exact IP addresses of your reverse proxy only; never add untrusted hosts.
BITGET_WEB_TRUSTED_PROXIES=127.0.0.1,::1
WEB_HOST=127.0.0.1
WEB_PORT=8091

# Read-only API credentials. Do not enable trading, transfers, or withdrawals.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
# classic or uta: must match your Bitget account mode.
BITGET_ACCOUNT_MODE=classic
BITGET_PRODUCT_TYPES=USDT-FUTURES
# Optional CFD monitoring uses separate read-only APIs, not a futures category.
BITGET_CFD_ENABLED=0
BITGET_MARGIN_COIN=
# Relative paths resolve from this repository's root.
DATABASE_PATH=data/positions.sqlite3
POLL_SECONDS=5
SNAPSHOT_SECONDS=60
REQUEST_TIMEOUT=15
SEND_STARTUP_SUMMARY=0
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# All notification channels are initially disabled because credentials are empty.
# You can configure them after login using the web UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_UPDATE_SECONDS=1
DISCORD_WEBHOOK_URL=
DISCORD_UPDATE_SECONDS=10
BARK_BASE=https://api.day.app
BARK_KEY=
BARK_SOUND=default
BARK_CALL=0
BARK_GROUP=bitget-orders
BARK_RECONCILE_SECONDS=30

# Estimated fee rebate: 0 means no assumed rebate. Set your actual ratio (0–1).
FEE_REBATE_RATE=0
WEB_HISTORY_LIMIT=100
WEB_HISTORY_TTL=60
WEB_ACCOUNT_TTL=30
# Defaults include history returned by Bitget; the API may only return recent records.
WEB_HISTORY_START=1970-01-01T00:00:00+00:00
HISTORY_RECONCILE_START=1970-01-01T00:00:00+00:00
